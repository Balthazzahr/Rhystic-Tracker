# Maintainer: Dave Pople <dave@rhystic.app>
# Contributor: Rhystic Tracker Contributors

pkgname=rhystic-tracker-git
_pkgname=rhystic-tracker
pkgver=1.3.4.r0.g5521159
pkgrel=1
pkgdesc="Real-time MTGA match tracking and deck analysis companion for Magic: The Gathering Arena (Git master version)"
arch=('x86_64')
url="https://github.com/Balthazzahr/Rhystic-Tracker"
license=('MIT')
depends=(
    'webkit2gtk-4.1'
    'libayatana-appindicator'
    'openssl'
    'hicolor-icon-theme'
)
makedepends=(
    'git'
    'rust'
    'cargo'
    'nodejs'
    'npm'
)
provides=('rhystic-tracker')
conflicts=('rhystic-tracker' 'rhystic-tracker-bin')
source=("git+https://github.com/Balthazzahr/Rhystic-Tracker.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/Rhystic-Tracker"
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || echo "1.3.4.r0"
}

build() {
    cd "${srcdir}/Rhystic-Tracker"
    npm ci
    npm run build
    npx @tauri-apps/cli build --no-bundle --features production-env
}

package() {
    cd "${srcdir}/Rhystic-Tracker"

    # Install binary
    install -Dm755 "src-tauri/target/release/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"

    # Install desktop entry
    install -Dm644 "packaging/${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${_pkgname}.desktop"

    # Install icon
    install -Dm644 "src-tauri/icons/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png"

    # Install license
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
