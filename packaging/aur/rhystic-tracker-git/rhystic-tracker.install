# rhystic-memread reads the collection out of the running Arena client, which
# needs CAP_SYS_PTRACE under Yama's default ptrace_scope=1. pacman doesn't
# preserve file capabilities from the package, so grant it here; an upgrade
# replaces the file and drops it, hence post_upgrade too.
post_install() {
    setcap cap_sys_ptrace+ep /usr/bin/rhystic-memread
}

post_upgrade() {
    post_install
}
