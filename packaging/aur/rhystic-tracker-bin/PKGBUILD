# Maintainer: Dave Pople <dave@rhystic.app>
# Contributor: Rhystic Tracker Contributors

pkgname=rhystic-tracker-bin
_pkgname=rhystic-tracker
pkgver=1.3.5
pkgrel=1
pkgdesc="Real-time MTGA match tracking and deck analysis companion for Magic: The Gathering Arena"
arch=('x86_64')
url="https://github.com/Balthazzahr/Rhystic-Tracker"
license=('MIT')
depends=(
    'webkit2gtk-4.1'
    'libayatana-appindicator'
    'openssl'
    'hicolor-icon-theme'
)
provides=('rhystic-tracker')
conflicts=('rhystic-tracker' 'rhystic-tracker-git')
source=(
    "${_pkgname}-${pkgver}.tar.gz::https://github.com/Balthazzahr/Rhystic-Tracker/releases/download/v${pkgver}/${_pkgname}-linux-x86_64.tar.gz"
    "https://raw.githubusercontent.com/Balthazzahr/Rhystic-Tracker/v${pkgver}/packaging/rhystic-tracker.desktop"
    "https://raw.githubusercontent.com/Balthazzahr/Rhystic-Tracker/v${pkgver}/src-tauri/icons/icon.png"
    "https://raw.githubusercontent.com/Balthazzahr/Rhystic-Tracker/v${pkgver}/LICENSE"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    # Install binary
    install -Dm755 "${srcdir}/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"

    # Install desktop entry
    install -Dm644 "${srcdir}/${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${_pkgname}.desktop"

    # Install application icon
    install -Dm644 "${srcdir}/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png"

    # Install license
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
