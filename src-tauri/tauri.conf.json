{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/tauri.conf.json",
  "productName": "Rhystic Tracker",
  "version": "0.1.0",
  "identifier": "com.rhystic.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "./node_modules/.bin/vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rhystic Tracker",
        "width": 1200,
        "height": 800,
        "minWidth": 768,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
