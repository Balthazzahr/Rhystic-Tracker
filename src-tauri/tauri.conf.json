{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/tauri.conf.json",
  "productName": "Rhystic Tracker",
  "version": "1.3.4",
  "identifier": "com.rhystic.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "./node_modules/.bin/vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rhystic Tracker",
        "width": 1200,
        "height": 800,
        "minWidth": 768,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/cardimg/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Magic: The Gathering Arena match tracker and deck analysis companion",
    "longDescription": "Rhystic Tracker parses MTGA Player.log in real time to build a local SQLite database of matches, decks, commanders, card combat metrics, and live match HUD feeds.",
    "category": "Game",
    "copyright": "© 2026 Rhystic Tracker Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
